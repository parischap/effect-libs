{
  "name": "@parischap/effect-lib",
  "type": "module",
  "author": "Jérôme MARTIN",
  "license": "MIT",
  "description": "Collection of utility modules extending the official effect library: simple yet efficient pattern matching, cycle-safe tree module, mutable caching with optional bounded capacity and optional time-to-live, number and BigDecimal rounding, number and DateTime parsing/formatting, sprintf/sscanf templating, and diverse useful stuff.",
  "homepage": "https://github.com/parischap/effect-libs/tree/master/packages/effect-lib",
  "scripts": {
    "test-all": "vitest run",
    "lint": "oxlint --disable-nested-config",
    "fmt": "oxfmt --disable-nested-config && oxlint --fix -disable-nested-config",
    "configs": "pnpm -w configs",
    "circular": "madge --extensions ts --circular --no-color --no-spinner esm",
    "check": "pnpm circular && pnpm lint && pnpm test-all",
    "lint-all": "pnpm lint",
    "fmt-all": "pnpm fmt",
    "check-all": "pnpm check",
    "examples": "tsx examples/perf.ts && tsx examples/Rounding_1.ts && tsx examples/Rounding_2.ts && tsx examples/Rounding_3.ts && tsx examples/NumberBase10Format_1.ts && tsx examples/NumberBase10Format_2.ts && tsx examples/Template_1.ts && tsx examples/Template_2.ts && tsx examples/Template_3.ts && tsx examples/DateTime_1.ts && tsx examples/DateTimeFormat_1.ts && tsx examples/DateTimeFormat_2.ts",
    "docgen": "docgen",
    "docgen-all": "pnpm docgen",
    "release": "pnpm publish dist --provenance --no-git-checks --access public",
    "release-all": "pnpm release"
  },
  "@parischap/configs": {
    "description": "Collection of utility modules extending the official effect library: simple yet efficient pattern matching, cycle-safe tree module, mutable caching with optional bounded capacity and optional time-to-live, number and BigDecimal rounding, number and DateTime parsing/formatting, sprintf/sscanf templating, and diverse useful stuff.",
    "moreDetails": "All exports follow the `M`-prefix naming convention to avoid name collisions with other libraries;\n\nPlatform-independent, well tested and documented, optimized for tree-shaking, 100% Typescript, 100% functional.\n\nCan also be used by non-effect users.",
    "version": "0.26.0",
    "keywords": [
      "pattern",
      "matching",
      "tree",
      "number",
      "date",
      "format",
      "parse",
      "formatting",
      "parsing",
      "rounding",
      "templating",
      "conversion",
      "sscanf",
      "sprintf",
      "text",
      "effect",
      "typescript",
      "functional-programming"
    ],
    "build": {
      "bundling": "InternalAndNpmBundling",
      "generateMaps": true,
      "addPureAnnotations": true,
      "generateCjs": true,
      "minify": true
    },
    "publishTarget": "Npm",
    "docScope": "skipInternal",
    "dependencies": {},
    "devDependencies": {},
    "environment": "Neutral",
    "examples": [
      "perf.ts",
      "Rounding_1.ts",
      "Rounding_2.ts",
      "Rounding_3.ts",
      "NumberBase10Format_1.ts",
      "NumberBase10Format_2.ts",
      "Template_1.ts",
      "Template_2.ts",
      "Template_3.ts",
      "DateTime_1.ts",
      "DateTimeFormat_1.ts",
      "DateTimeFormat_2.ts"
    ],
    "packagePrefix": "M",
    "peerDependencies": {
      "effect": "*"
    },
    "scripts": {},
    "prodMiscellaneous": {}
  },
  "exports": {
    ".": {
      "default": "./esm/index.ts"
    },
    "./MArray": {
      "default": "./esm/Array.ts"
    },
    "./MBigDecimal": {
